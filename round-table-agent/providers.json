{
  "providers": [
    { "id": "omni", "baseURL": "http://localhost:20128/v1", "model": "free", "authKeyName": "omni" },
    { "id": "deepseek", "baseURL": "https://api.deepseek.com/v1", "model": "deepseek-chat", "authKeyName": "deepseek" },
    { "id": "ai2", "baseURL": "http://127.0.0.1:3000/openai-codex-oauth/v1", "model": "gpt-5.6-luna", "authKeyName": "ai2", "disabled": true }
  ],
  "defaultSeats": [
